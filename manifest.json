{
  "schemaVersion": 1,
  "id": "yubinex.paddock-clock",
  "name": "Paddock Clock",
  "version": "1.2.0",
  "author": "yubinex",
  "description": "A clock showing the local time at the circuit hosting the current or next Formula 1 race.",
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Paddock Clock",
    "description": "Local time at the current or next Formula 1 circuit, in a clock panel.",
    "category": "Info",
    "aliases": ["f1", "formula1", "track", "timezone", "clock"],
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "digitalClock": false,
      "barIcon": "Flag"
    },
    "schema": [
      {"key": "digitalClock", "type": "boolean", "label": "Digital clock"},
      {"key": "barIcon", "type": "enum", "label": "Bar icon", "options": ["Flag", "Globe"]}
    ]
  }
}
